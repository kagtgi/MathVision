{
  "name": "math-vision",
  "private": true,
  "version": "1.3.0",
  "description": "Chuyển đề thi toán từ ảnh hoặc PDF thành file Word đúng chuẩn, tự giải và sinh đáp án chi tiết.",
  "author": "MathVision Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagtgi/MathVision.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "electron:preview": "npm run build && electron .",
    "electron:build": "node scripts/fix-electron-cache.cjs && npm run build && electron-builder --win",
    "verify": "node scripts/verify-pipeline.mjs && node scripts/verify-docx.mjs && node scripts/verify-numbering.mjs && node scripts/verify-tikz-sanitize.mjs && node scripts/verify-tikz-corpus.mjs && node scripts/verify-figure-policy.mjs && node scripts/verify-figure-gen.mjs && node scripts/verify-history.mjs && node scripts/verify-solver-shape.mjs && node scripts/verify-vdc.mjs && node scripts/verify-textlayer.mjs && node scripts/verify-download.mjs && node scripts/verify-update.mjs && node scripts/verify-secrets.mjs && node scripts/verify-history-app.mjs",
    "verify:ci": "node scripts/verify-numbering.mjs && node scripts/verify-tikz-sanitize.mjs && node scripts/verify-tikz-corpus.mjs && node scripts/verify-figure-policy.mjs && node scripts/verify-figure-gen.mjs && node scripts/verify-history.mjs && node scripts/verify-solver-shape.mjs && node scripts/verify-vdc.mjs && node scripts/verify-textlayer.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "docx": "^9.6.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "mathpix-markdown-it": "^3.0.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wawoff2": "^2.0.1"
  },
  "build": {
    "appId": "ai.tasih.mathvision",
    "productName": "MathVision",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**",
      "node_modules/{electron-updater,builder-util-runtime,js-yaml,argparse,semver,lodash.escaperegexp,lodash.isequal,lazy-val,fs-extra,jsonfile,graceful-fs,universalify,tiny-typed-emitter,debug,ms,sax}/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kagtgi",
        "repo": "MathVision"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MathVision-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MathVision",
      "artifactName": "MathVision-Setup.${ext}"
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "MathVision-${version}.exe"
    },
    "extraResources": [
      {
        "from": "mathtype",
        "to": "mathtype",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
